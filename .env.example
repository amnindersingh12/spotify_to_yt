# You need to create a Spotify application in the Spotify Developer Dashboard (developer.spotify.com)
# Grab your Client ID and Client Secret, and set your Redirect URI to: http://localhost:8888/callback

SPOTIPY_CLIENT_ID=your_spotify_client_id_here
SPOTIPY_CLIENT_SECRET=your_spotify_client_secret_here
SPOTIPY_REDIRECT_URI=http://localhost:8888/callback
